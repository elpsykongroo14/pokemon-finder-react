# copy this file to .env and fill in your own values
# (.env is gitignored - .env.example is the template that IS committed)

# the tcg-proxy Cloudflare Worker URL. the deployed one below allows
# localhost:5173, so local development works with it as is.
# the worker's source and setup: https://github.com/elpsykongroo14/pokemon-finder-tcg-proxy
VITE_TCG_PROXY="https://tcg-proxy.tcg-proxy.workers.dev"