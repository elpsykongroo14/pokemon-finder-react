# Cloudflare Pages response headers (copied into dist/ by Vite, like _redirects).

# Vite names every built JS/CSS file after a hash of its content
# (index-DTNG_Oex.js). A changed file gets a NEW name, so a name never
# points at different bytes: browsers may keep these for a year and never
# re-check. index.html and the rest keep the default (re-check every time),
# because index.html is the pointer that names the current hashed files.
/assets/*
  Cache-Control: public, max-age=31536000, immutable